# Mock BSE API (Part A)
BSE_BASE_URL=http://localhost:4000

# Supabase local dev (from `supabase start` output) or your project URL
SUPABASE_URL=http://localhost:54321
# service_role key — NEVER expose this to the browser/portal. It bypasses
# RLS on purpose, because this worker is the only writer.
SUPABASE_SERVICE_ROLE_KEY=

# Tuning (defaults are sane for local dev; lower BSE_DELAY_MS in Part A while
# developing, but the design must remain correct at BSE_DELAY_MS=30000 /
# BSE_FAILURE_RATE=0.2, i.e. the real 10-minute/20%-failure scenario)
PULL_PAGE_SIZE=50
PULL_MAX_RETRIES=5
PULL_RETRY_BASE_DELAY_MS=1000
PULL_REQUEST_TIMEOUT_MS=28000
INCREMENTAL_INTERVAL_MS=30000
RECONCILE_INTERVAL_MS=3600000
FAST_POLL_INTERVAL_MS=15000
